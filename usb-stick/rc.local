#!/bin/sh
# rc.local: wird von /etc/init.d/shelby_local beim Boot ausgefuehrt.
#
# Diese Datei landet via install.sh in /mnt/nv/rc.local (NAND, read write).
# Sie ist absichtlich klein und stabil. Die eigentliche Bootstrap Logik
# liegt auf dem USB Stick in run.sh und kann dort jederzeit aktualisiert
# werden ohne /mnt/nv anzufassen.

set -u

LOGDIR="/mnt/nv/streborn"
mkdir -p "$LOGDIR" 2>/dev/null || true

# Erster Reboot Marker, hilft beim Debuggen falls Stick fehlt
echo "$(date): rc.local triggered" >> "$LOGDIR/boot.log"

# Defined HERE, above their first caller, for the same reason as
# install_boot_script below: sh runs this file top to bottom.
# usb-stick/tests/foreign_stick_test.sh guards the order.
stick_has_str_marker() {
    # Returns 0 when the directory $1 is the top level of an STR or Bose stick.
    #
    # KEEP BYTE-IDENTICAL to its twin in the other file (usb-stick/rc.local and
    # usb-stick/run.sh, for the reason given at install_boot_script), together
    # with usb_stick_mounts and foreign_stick_only below.
    # usb-stick/tests/foreign_stick_test.sh fails if the copies drift.
    #
    # A stick that is not ours (a music stick left in the speaker) must not be
    # waited on, fscked, mounted over or written to. A marker is any file STR's
    # install wizard puts on a stick (sticksetup.PayloadFileNames: the
    # usb-stick templates, the agent, the Spotify engine, the version stamp and
    # the wizard's config files; sticksetup's tests fail when a payload file is
    # missing here), the keep-open debug switch, or a file the Bose firmware
    # itself reacts to (remote_services, Update.stu). What STR only ever writes
    # ONTO a stick it already recognised (setup.log, cap*.ogg) is deliberately
    # not a marker: a music stick an older STR scribbled on would otherwise
    # stay "ours" for good. FAT matches names without regard to case; Update.stu
    # is also listed in the other spellings a case-sensitive file system shows.
    [ -n "${1:-}" ] && [ -d "$1" ] || return 1
    for _shsm in \
        run.sh install.sh rc.local autostart.sh provision-wlan.sh \
        iptables-setup.sh setup-tls.sh presets.json version.txt str-shim.so \
        streborn-armv7l streborn go-librespot remote_services keep-open \
        wlan.conf wlan.ssid wlan.pass region.conf name.conf name.raw lang.conf \
        Update.stu update.stu UPDATE.STU; do
        [ -e "$1/$_shsm" ] && return 0
    done
    return 1
}

usb_stick_mounts() {
    # Prints the mount point of every mounted USB stick file system, one per
    # line. Bose's udev mount.sh puts a stick at /media/sd<x><n>, the places
    # the boot scripts search for STR's stick, so that is what counts. Only
    # the mount point is matched, never a bare /dev/sd* device: what else a
    # host has mounted from one (a test runner's own disk) is not a stick.
    # PROC_MOUNTS is a test seam and nothing else; on the speaker it is
    # /proc/mounts.
    [ -r "${PROC_MOUNTS:-/proc/mounts}" ] || return 0
    while read -r _usm_dev _usm_mnt _usm_rest; do
        case "$_usm_mnt" in
            /media/sd*) echo "$_usm_mnt" ;;
        esac
    done < "${PROC_MOUNTS:-/proc/mounts}"
}

foreign_stick_only() {
    # Returns 0 when at least one USB stick is mounted and none of the mounted
    # ones carries an STR or Bose marker: the only stick in the speaker is the
    # user's own. The boot then goes on as if no stick were in. Returns 1 when
    # nothing is mounted (yet), so a stick that is still mounting is waited on
    # as before, and when any mounted stick is ours.
    _fso_rc=1
    for _fso_mnt in $(usb_stick_mounts); do
        stick_has_str_marker "$_fso_mnt" && return 1
        _fso_rc=0
    done
    return $_fso_rc
}

# USB stick is mounted async by udev. Both the NAND override path
# and the fallback path need the stick directory (binary,
# version.txt, wlan.conf). Wait up to 30s for the stick before
# deciding — otherwise run.sh fires, finds an empty NAND cache
# plus a not-yet-mounted stick, and aborts with "weder NAND Cache
# noch Stick Binary verfuegbar". The stick may legitimately never
# appear (post-install, user pulled it). In that case we still
# fall back to NAND override below.
#
# But only wait when there is reason to. Bose's shelby_local runs this
# file SYNCHRONOUSLY and only afterwards brings the network up (ifup eth0
# on BCO, the wlan1 setup on sm2) and lets S99SoundTouch start BoseApp.
# An unconditional 30s wait therefore made every stickless boot of every
# installed speaker 30s slower, and on BCO the network came up 30s late
# (boot.log: "rc.local triggered" and "NAND override active" exactly 30s
# apart). USB enumeration is done long before S97, so with a NAND override
# in place and no USB mass-storage device at all (no /sys/block/sd*, no
# USB interface of class 08) there is no stick that could still mount, and
# we go straight on. We keep the full bounded wait when a mass-storage
# device exists (the udev mount is async), when there is no NAND override
# yet (the stick is then the only way to start), and when /sys/block is
# not visible (we cannot tell, so behave as before).
STICK_WAIT_MAX=30
usb_storage_seen() {
    # Prints what it found and returns 0 when a USB mass-storage device is
    # present, mounted or not.
    for _usb in /sys/block/sd*; do
        [ -e "$_usb" ] && { echo "${_usb##*/}"; return 0; }
    done
    for _usb in /sys/bus/usb/devices/*/bInterfaceClass; do
        [ -r "$_usb" ] || continue
        if [ "$(cat "$_usb" 2>/dev/null)" = "08" ]; then
            _usb="${_usb%/bInterfaceClass}"
            echo "USB interface ${_usb##*/}"
            return 0
        fi
    done
    return 1
}
if [ ! -x /mnt/nv/streborn/run-override.sh ]; then
    STICK_WAIT=$STICK_WAIT_MAX
    echo "$(date): no NAND override yet, waiting up to ${STICK_WAIT}s for the stick" >> "$LOGDIR/boot.log"
elif [ ! -d /sys/block ]; then
    STICK_WAIT=$STICK_WAIT_MAX
    echo "$(date): /sys/block not visible, waiting up to ${STICK_WAIT}s for the stick" >> "$LOGDIR/boot.log"
elif USB_SEEN=$(usb_storage_seen); then
    STICK_WAIT=$STICK_WAIT_MAX
    echo "$(date): USB storage present ($USB_SEEN), waiting up to ${STICK_WAIT}s for the stick" >> "$LOGDIR/boot.log"
else
    STICK_WAIT=0
    echo "$(date): no USB storage, not waiting for a stick" >> "$LOGDIR/boot.log"
fi
#
# Mount path discovery: Bose's udev rule almost always lands the
# first USB block device at /media/sda1 across all SoundTouch
# models (ST10 micro-USB, ST20/30 USB-A; same udev script). On a
# firmware variant that numbers differently (e.g. /media/sdb1 if
# something else claimed sda first), we still find the stick.
# /media/sda1 stays the primary check so existing behaviour is
# preserved on every box that already worked.
#
# The loop always probes once, so a stick that is already mounted is found
# even when STICK_WAIT is 0.
STICK_PATH=""
i=0
while :; do
    for cand in /media/sda1 /media/sdb1 /media/sdc1 /media/sdd1; do
        if [ -e "$cand/run.sh" ] || [ -e "$cand/streborn-armv7l" ]; then
            STICK_PATH="$cand"
            break
        fi
    done
    if [ -n "$STICK_PATH" ]; then
        echo "$(date): stick detected at $STICK_PATH after ${i}s" >> "$LOGDIR/boot.log"
        break
    fi
    # A mounted stick without any STR or Bose marker is the user's own (a
    # music stick left in). Waiting the full STICK_WAIT for it to turn into an
    # STR stick only made every such boot 30s slower, so go on at once, as if
    # no stick were in. A stick that is still mounting has no /proc/mounts
    # entry yet, so it is still waited on exactly as before.
    if foreign_stick_only; then
        echo "$(date): only a non-STR USB stick is mounted ($(usb_stick_mounts | tr '\n' ' ')), going on without a stick after ${i}s" >> "$LOGDIR/boot.log"
        break
    fi
    if [ $i -ge "$STICK_WAIT" ]; then
        [ "$STICK_WAIT" -gt 0 ] && echo "$(date): no stick after ${i}s, going on without it" >> "$LOGDIR/boot.log"
        break
    fi
    sleep 1
    i=$((i+1))
done
# Backwards compatibility: downstream code still references
# /media/sda1 hardcoded in many places. If the stick landed
# elsewhere, expose it via a symlink so legacy paths keep working
# without touching the agent binary or run.sh internals.
if [ -n "$STICK_PATH" ] && [ "$STICK_PATH" != "/media/sda1" ]; then
    if [ ! -e /media/sda1 ]; then
        ln -s "$STICK_PATH" /media/sda1 2>/dev/null \
            && echo "$(date): /media/sda1 -> $STICK_PATH symlink set for legacy paths" >> "$LOGDIR/boot.log"
    fi
fi

# Defined HERE, above its first caller, on purpose: sh runs this file top to
# bottom, so a call that precedes the definition is "not found" (rc 127) and
# falls into the caller's failure branch. That is how the stick redeploy below
# silently never worked from v0.9.94 until the definitions were moved up.
# usb-stick/tests/boot_install_test.sh guards the order.
install_boot_script() {
    # Stage, validate, then rename a boot script into place.
    #
    # KEEP BYTE-IDENTICAL to its twin in the other file. usb-stick/rc.local
    # and usb-stick/run.sh both need this, they cannot share one copy
    # (rc.local runs before anything is sourceable, and a sourced helper
    # would add a failure mode to the thing being hardened), and
    # usb-stick/tests/boot_install_test.sh fails if the two drift.
    #
    # $1 = source, $2 = destination. Returns 0 only when $2 now holds the
    # whole of $1, 2 when a suspiciously short replacement was refused, and
    # 1 on any other failure. Logs nothing, so both callers log in their own
    # style.
    #
    # Why rename instead of cp: cp opens the destination with O_TRUNC before
    # reading a byte of the source, so an interrupted read leaves a truncated
    # file that is still chmod +x and the boot execs it. rename is atomic, so
    # the destination is either the old script or the whole new one. It also
    # makes it safe to replace a script that is CURRENTLY EXECUTING: the
    # running shell keeps reading the old inode through its open fd instead of
    # having the bytes shift underneath it mid-statement.
    [ -r "$1" ] || return 1
    _ibs_new="$2.new"
    rm -f "$_ibs_new" 2>/dev/null
    cp "$1" "$_ibs_new" 2>/dev/null || { rm -f "$_ibs_new" 2>/dev/null; return 1; }
    _ibs_ssz=$(wc -c < "$1" 2>/dev/null | tr -d " \t")
    _ibs_nsz=$(wc -c < "$_ibs_new" 2>/dev/null | tr -d " \t")
    # A short read is the failure this function exists for.
    if [ -z "$_ibs_nsz" ] || [ "$_ibs_nsz" = "0" ] || [ "$_ibs_nsz" != "$_ibs_ssz" ]; then
        rm -f "$_ibs_new" 2>/dev/null
        return 1
    fi
    # A script the box's own shell cannot parse must never become the boot
    # path. This is what catches a SOURCE that is itself half-written.
    sh -n "$_ibs_new" 2>/dev/null || { rm -f "$_ibs_new" 2>/dev/null; return 1; }
    # A stick truncated at a statement boundary still parses, so also refuse
    # a replacement that is drastically shorter than the working script.
    if [ -s "$2" ]; then
        _ibs_osz=$(wc -c < "$2" 2>/dev/null | tr -d " \t")
        if [ -n "$_ibs_osz" ] && [ "$_ibs_nsz" -lt $(( _ibs_osz / 2 )) ]; then
            rm -f "$_ibs_new" 2>/dev/null
            return 2
        fi
    fi
    chmod +x "$_ibs_new" 2>/dev/null
    mv -f "$_ibs_new" "$2" 2>/dev/null || { rm -f "$_ibs_new" 2>/dev/null; return 1; }
    sync 2>/dev/null
    return 0
}

# Unconditional self-update from stick. Brute force: if the stick
# has the file, we copy it. No mtime comparison, no version check.
#
# Why unconditional: the previous `-nt` mtime guard was a reliability
# tax. The box's RTC starts at 2015 on cold boot, NTP sync may or may
# not have run when this copy fires, and FAT32 mtimes have 2s
# resolution. The combination meant a freshly-prepared stick could
# look "older" than the NAND copy and be silently skipped. Result:
# the box stayed on a stale binary across multiple cold boots, the
# user could not figure out why, the Setup Wizard looked broken.
# Live-verified 2026-05-24 on ST10 .66.
#
# Risk vector: a broken stick now bricks the bootstrap. Mitigated
# by the fact that the stick IS the repair channel — the user can
# re-prepare it from any working Setup Wizard and the next boot
# heals. The fail-closed "stick wins, every time" model matches the
# user's mental model: "what I just put on the stick is what the
# box will run".
#
# Each `cp` is followed by chmod so a stick that lost +x (sync via
# Windows file-manager strips perms) still produces an executable
# script on NAND.
#
#   * rc.local update takes effect on the NEXT boot (this run is
#     already past the wait loop, but cannot safely re-exec itself
#     without risking a loop).
#   * run-override.sh update takes effect on THIS boot because we
#     invoke it immediately below.
if [ -f /media/sda1/rc.local ]; then
    install_boot_script /media/sda1/rc.local /mnt/nv/rc.local
    case $? in
        0) echo "$(date): /mnt/nv/rc.local redeployed from stick (effective next boot)" >> "$LOGDIR/boot.log" ;;
        2) echo "$(date): /mnt/nv/rc.local NOT redeployed: the stick copy is far shorter than the working one, keeping the working one" >> "$LOGDIR/boot.log" ;;
        *) echo "$(date): /mnt/nv/rc.local NOT redeployed: the stick copy did not validate, keeping the working one" >> "$LOGDIR/boot.log" ;;
    esac
fi
if [ -f /media/sda1/run.sh ]; then
    install_boot_script /media/sda1/run.sh /mnt/nv/streborn/run-override.sh
    case $? in
        0) echo "$(date): /mnt/nv/streborn/run-override.sh redeployed from stick (effective this boot)" >> "$LOGDIR/boot.log" ;;
        2) echo "$(date): run-override.sh NOT redeployed: the stick copy is far shorter than the working one, keeping the working one" >> "$LOGDIR/boot.log" ;;
        *) echo "$(date): run-override.sh NOT redeployed: the stick copy did not validate, keeping the working one" >> "$LOGDIR/boot.log" ;;
    esac
fi

# The NAND override wins. That is what lets an update survive an SD card
# that is read only or still carries an old run.sh.
NAND_OVERRIDE="/mnt/nv/streborn/run-override.sh"
if [ -x "$NAND_OVERRIDE" ]; then
    echo "$(date): NAND override active, using $NAND_OVERRIDE" >> "$LOGDIR/boot.log"
    nohup "$NAND_OVERRIDE" > "$LOGDIR/run.out" 2>&1 &
    exit 0
fi

# Fallback without a NAND override: start the stick's run.sh directly if present.
if [ -x /media/sda1/run.sh ]; then
    echo "$(date): no NAND override, using /media/sda1/run.sh" >> "$LOGDIR/boot.log"
    nohup /media/sda1/run.sh > "$LOGDIR/run.out" 2>&1 &
    exit 0
fi

echo "$(date): neither a NAND override nor /media/sda1/run.sh, USB stick missing" >> "$LOGDIR/boot.log"
exit 1
